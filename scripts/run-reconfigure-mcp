#!/usr/bin/env bash
set -euo pipefail

ENV_FILE=/home/hermes/.hermes/ha-mcp-reconfigure.env
if [[ ! -r "$ENV_FILE" ]]; then
  printf 'Missing %s\n' "$ENV_FILE" >&2
  exit 78
fi

# shellcheck disable=SC1090
source "$ENV_FILE"
if [[ -z "${HOMEASSISTANT_TOKEN:-}" ]]; then
  printf 'HOMEASSISTANT_TOKEN is empty in %s; refusing to start.\n' "$ENV_FILE" >&2
  exit 78
fi

cd /home/hermes/workspace/ha-mcp
exec /home/hermes/workspace/ha-mcp/.venv/bin/ha-mcp-web
